{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Vestige 编剧工作台",
  "version": "3.0.0",
  "identifier": "com.vestige.writerstudio",
  "build": {
    "frontendDist": "../bootstrap"
  },
  "app": {
    "windows": [],
    "withGlobalTauri": false,
    "security": {
      "capabilities": [],
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; script-src 'self'; object-src 'none'; base-uri 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app"
    ],
    "externalBin": [
      "binaries/vestige-service",
      "binaries/vestige-cli",
      "binaries/vestige-restore"
    ],
    "category": "Productivity",
    "shortDescription": "从作品证据提炼编剧方法，与 Agent 协作完成原创剧本",
    "macOS": {
      "minimumSystemVersion": "13.0"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
